{
  "name": "atrio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "npm run install:all && npm run env:setup && npm run playwright:install && npm run docker:up && npm run docker:wait && npm run db:test:setup",
    "install:all": "npm install",
    "env:setup": "if [ ! -f .env ]; then cp .env.example .env; fi",
    "playwright:install": "npx --workspace=apps/frontend playwright install chromium",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:wait": "ts-node --project scripts/tsconfig.json scripts/wait-for-services.ts",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "db:test:setup": "bash scripts/setup-test-db.sh",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w apps/backend\" \"npm run dev -w apps/frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration -w apps/backend",
    "test:e2e": "npm run test:e2e --workspaces",
    "test:frontend": "npm run test --workspace=apps/frontend",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "check:openapi": "echo 'Not implemented'",
    "check:bdd": "echo 'Not implemented'",
    "storybook": "npm run storybook --workspace=apps/frontend",
    "storybook:local": "npm run storybook --workspace=apps/frontend",
    "storybook:docker": "docker compose --profile dev up storybook",
    "storybook:build": "npm run storybook:build --workspace=apps/frontend",
    "coverage:check": "echo 'Not implemented'"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^20.3.1",
    "concurrently": "^10.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "body-parser": "^1.20.8",
    "file-type": "21.3.4",
    "glob": "^11.1.0",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "minimatch": "^9.0.7",
    "multer": "^2.4.0",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.28",
    "qs": "^6.16.0",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "webpack": "^5.105.0"
  }
}
