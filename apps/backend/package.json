{
  "name": "atrio-backend",
  "version": "1.0.0",
  "description": "Atrio Backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start --env-file ../../.env",
    "start:dev": "nest start --watch --env-file ../../.env",
    "dev": "nest start --watch --env-file ../../.env",
    "start:debug": "nest start --debug --watch --env-file ../../.env",
    "start:prod": "node --env-file=../../.env dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config ./jest.config.ts",
    "test:unit": "jest --config ./jest.config.ts",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:coverage": "jest --config ./jest.config.ts --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docs:api": "ts-node scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "^5.7.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "ioredis": "^5.3.2",
    "nestjs-pino": "^4.6.1",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "^12.1.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.2",
    "prisma": "^5.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  }
}
